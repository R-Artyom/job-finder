<IfModule mod_rewrite.c>
RewriteEngine On

#############################################
# 1. Статические файлы - пропускаем
#############################################
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

#############################################
# 1.1 Favicon из сборки Vue
#############################################
RewriteCond %{DOCUMENT_ROOT}/frontend/dist/favicon.svg -f
RewriteRule ^favicon\.svg$ frontend/dist/favicon.svg [L]

#############################################
# 2. Vue assets
#############################################
RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]

#############################################
# 3. Laravel API (обязательно должно быть до Vue SPA)
#############################################
RewriteRule ^api/(.*)$ public/index.php [L]

#############################################
# 4. Vue SPA
#############################################
RewriteRule ^$ frontend/dist/index.html [L]
RewriteRule ^.*$ frontend/dist/index.html [L]

</IfModule>